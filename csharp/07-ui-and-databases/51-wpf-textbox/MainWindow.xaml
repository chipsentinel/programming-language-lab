<Window x:Class="WpfTextBox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cuadros de texto" Height="360" Width="420"
        WindowStartupLocation="CenterScreen">

    <!-- WindowStartupLocation="CenterScreen": la ventana aparece en el centro de la pantalla -->

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">

        <Label Content="Ingrese su nombre" FontSize="14" />

        <!--
            TextBox: un cuadro de texto para escribir. Lo que se escribe está en la propiedad Text.
            FontFamily y FontSize: letra con la que escribe el usuario.
            Foreground: color de la letra. Background: color de fondo.
            x:Name da el nombre para usarlo desde C# (sin x:Name no se puede leer ni cambiar).
        -->
        <TextBox x:Name="txtNombre" FontFamily="Arial" FontSize="16"
                 Foreground="DarkBlue" Background="White" Margin="0,0,0,12" />

        <Label Content="Ingrese su edad" FontSize="14" />
        <TextBox x:Name="txtEdad" FontFamily="Arial" FontSize="16"
                 Foreground="DarkBlue" Background="White" Width="80" HorizontalAlignment="Left"
                 Margin="0,0,0,16" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
            <Button x:Name="btnIngresar" Content="Ingresar" Width="100" Height="32" Margin="0,0,12,0"
                    FontSize="14" Click="BtnIngresar_Click" />
            <Button x:Name="btnBorrar" Content="Borrar" Width="100" Height="32"
                    FontSize="14" Click="BtnBorrar_Click" />
        </StackPanel>

        <Label x:Name="lResultado" Content="Resultado" FontSize="18" Foreground="DarkGreen"
               HorizontalAlignment="Center" />
    </StackPanel>
</Window>
