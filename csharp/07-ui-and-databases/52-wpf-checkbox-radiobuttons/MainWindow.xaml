<Window x:Class="WpfCheckboxRadiobuttons.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pizzas y bebidas" Height="380" Width="560"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="24" VerticalAlignment="Center">

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

            <!--
                CheckBox: casilla de verificación. Se pueden marcar varias a la vez (cada una es independiente).
                Content es el texto que se ve. IsChecked indica si está marcada.
                Prefijo ck en el nombre: ck01, ck02...
            -->
            <StackPanel Width="280">
                <Label Content="Indique su sabor de pizza" FontFamily="Verdana" FontSize="15"
                       Foreground="DarkBlue" />

                <CheckBox x:Name="ck01" Content="Pizza de queso - $150.00" FontFamily="Verdana" FontSize="14"
                          Foreground="DarkGreen" Margin="6,6,0,0" />
                <CheckBox x:Name="ck02" Content="Pizza de jamón y queso - $250.00" FontFamily="Verdana" FontSize="14"
                          Foreground="DarkGreen" Margin="6,6,0,0" />
                <CheckBox x:Name="ck03" Content="Pizza de queso y pepperoni - $200.00" FontFamily="Verdana" FontSize="14"
                          Foreground="DarkGreen" Margin="6,6,0,0" />
            </StackPanel>

            <!--
                RadioButton: botón de opción. Entre los de un mismo grupo solo se puede elegir UNO.
                Los RadioButton que están dentro del mismo contenedor forman un grupo
                (o se agrupan con la propiedad GroupName). Prefijo rb: rb01, rb02...
            -->
            <StackPanel Width="220">
                <Label Content="Indique su bebida" FontFamily="Verdana" FontSize="15"
                       Foreground="DarkBlue" />

                <RadioButton x:Name="rb01" Content="Pepsi - $30.00" FontFamily="Verdana" FontSize="14"
                             Foreground="DarkOliveGreen" Margin="6,6,0,0" />
                <RadioButton x:Name="rb02" Content="Coca-Cola - $30.00" FontFamily="Verdana" FontSize="14"
                             Foreground="DarkOliveGreen" Margin="6,6,0,0" />
                <RadioButton x:Name="rb03" Content="Sprite - $25.00" FontFamily="Verdana" FontSize="14"
                             Foreground="DarkOliveGreen" Margin="6,6,0,0" />
            </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,16">
            <Button x:Name="bOrdenar" Content="Ordenar" Width="120" Height="34" Margin="0,0,12,0"
                    FontFamily="Arial" FontWeight="Bold" FontSize="16" Background="LightGreen"
                    Click="BOrdenar_Click" />
            <Button x:Name="bCancelar" Content="Cancelar" Width="120" Height="34"
                    FontFamily="Arial" FontWeight="Bold" FontSize="16" Background="LightSalmon"
                    Click="BCancelar_Click" />
        </StackPanel>

        <!-- Total de la orden: la etiqueta de la derecha (lTotal) empieza vacía y se rellena desde C# -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Label Content="Total de la orden:" FontSize="16" />
            <Label x:Name="lTotal" Content="" FontSize="16" FontWeight="Bold" Foreground="DarkRed" />
        </StackPanel>
    </StackPanel>
</Window>
